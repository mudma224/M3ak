/corpus/
/pilot/raw/
/pilot/normalized/
/pilot/segments/
*.pdf
!docs/**/*.pdf

# --- Éditeurs et système ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Outils et états locaux sans rapport avec la plateforme ---
.docgen/
.mimosa/
.zcode/
/pilot/classement/
tableau.html

# --- Artefacts de vérification de types ---
*.tsbuildinfo

# --- Worker pdf.js (copié depuis node_modules par predev/prebuild) ---
services/frontend/public/pdf.worker.min.mjs

# --- Documents internes (dépôt destiné à être public) ---
