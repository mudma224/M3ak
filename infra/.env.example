# Variables d'environnement locales de développement M3ak.
# Copier ce fichier vers .env puis adapter chaque valeur.
# Règle : aucun secret n'est versionné ; .env est exclu de git (.gitignore).

# ── Jeton d'authentification inter-services (en-tête X-Internal-Token) ──
# Générer une valeur : python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_TOKEN=remplacer-par-un-jeton-aleatoire

# ── Traefik : point d'accès au daemon Docker ──
# Sur Docker Desktop Windows/WSL2, le socket Unix proxié peut renvoyer des réponses
# malformées ("Error response from daemon: "). Contournement : activer "Expose daemon
# on TCP without TLS" (Settings → Advanced) et décommenter la ligne suivante.
# ⚠ Développement local uniquement : port 2375 sans authentification.
#TRAEFIK_DOCKER_ENDPOINT=tcp://host.docker.internal:2375

# ── Mots de passe des cinq bases (un utilisateur par service) ──
POSTGRES_CORPUS_PASSWORD=remplacer
POSTGRES_RECHERCHE_PASSWORD=remplacer
POSTGRES_CONVERSATION_PASSWORD=remplacer
POSTGRES_DOCUMENTS_PASSWORD=remplacer
POSTGRES_LLM_PASSWORD=remplacer

# ── Courtier RabbitMQ ──
RABBITMQ_USER=m3ak
RABBITMQ_PASSWORD=remplacer

# ── Stockage objet MinIO ──
MINIO_ROOT_USER=m3ak
MINIO_ROOT_PASSWORD=remplacer-par-16-caracteres-minimum

# ── Service llm : fournisseurs de génération (zai | google | local) ──
# Fournisseur par défaut : zai | google | local (LM Studio sur l'hôte).
# Basculer = changer LLM_FOURNISSEUR_DEFAUT (+ la clé du fournisseur choisi).
# Clés : z.ai model / aistudio.google.com/apikey — jamais versionnées.
# Z.ai : API PaaS v4 par défaut ; abonnement GLM Coding Plan →
# LLM_ZAI_URL=https://api.z.ai/api/coding/paas/v4
ZAI_API_KEY=
LLM_ZAI_URL=https://api.z.ai/api/paas/v4
LLM_ZAI_MODELE=glm-5.3-flash
GOOGLE_API_KEY=
LLM_FOURNISSEUR_DEFAUT=zai
LLM_GOOGLE_MODELE=gemini-3.8-flash
# Serveur local compatible OpenAI (LM Studio → Developer → Start server, port 1234).
# Modèle vide = auto-détection (premier modèle chargé dans LM Studio).
LLM_LOCAL_URL=http://host.docker.internal:1234/v1
LLM_LOCAL_MODELE=
# Quota global plateforme (fenêtres glissantes) — à ajuster selon le plan.
LLM_QUOTA_REQUETES_MINUTE=20
LLM_QUOTA_JETONS_JOUR=500000
